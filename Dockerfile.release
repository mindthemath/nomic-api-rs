# Dockerfile for building images from GitHub release artifacts
# This avoids rebuilding binaries - just downloads pre-built releases and packages them

# Build arguments
ARG GITHUB_REPOSITORY=mindthemath/nomic-api-rs
ARG VERSION

# ============================================================================
# Stage 1: Download and extract artifacts
# ============================================================================
FROM debian:trixie-20260112-slim AS downloader

ARG GITHUB_REPOSITORY
ARG VERSION
ARG TARGETARCH

# Install dependencies for downloading and extracting
RUN apt-get update && apt-get install -y \
    curl \
    tar \
    gzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /downloads

# Download binary tarball (platform determined by TARGETARCH)
RUN set -eux && \
    if [ -z "$VERSION" ]; then \
        echo "ERROR: VERSION build arg is required"; \
        exit 1; \
    fi && \
    # Map Docker's TARGETARCH to release artifact naming
    case "$TARGETARCH" in \
        amd64) PLATFORM="linux-x64" ;; \
        arm64) PLATFORM="linux-arm64" ;; \
        *) echo "ERROR: Unsupported architecture: $TARGETARCH"; exit 1 ;; \
    esac && \
    RELEASE_URL="https://github.com/${GITHUB_REPOSITORY}/releases/download/v${VERSION}/nomic-embed-v1.5-${VERSION}-${PLATFORM}.tar.gz" && \
    echo "Downloading binary v${VERSION} for ${PLATFORM} from: $RELEASE_URL" && \
    curl -Lf -o binary.tar.gz "$RELEASE_URL" || { echo "Failed to download binary from $RELEASE_URL"; exit 1; } && \
    tar -xzf binary.tar.gz && \
    mv nomic-embed-v1.5-*/nomic-serve ./nomic-serve && \
    chmod +x ./nomic-serve && \
    rm -rf nomic-embed-v1.5-* binary.tar.gz

# Download CUDA provider libraries (x64 only, optional for GPU support)
RUN set -eux && \
    mkdir -p ./lib && \
    if [ "$TARGETARCH" = "amd64" ]; then \
        CUDA_LIBS_URL="https://github.com/${GITHUB_REPOSITORY}/releases/download/v${VERSION}/nomic-embed-v1.5-${VERSION}-cuda-libs.tar.gz" && \
        echo "Downloading CUDA libraries from: $CUDA_LIBS_URL" && \
        if curl -Lf -o cuda-libs.tar.gz "$CUDA_LIBS_URL" 2>/dev/null; then \
            tar -xzf cuda-libs.tar.gz && \
            mv nomic-embed-v1.5-*/lib/* ./lib/ 2>/dev/null || mv nomic-embed-v1.5-*/* ./lib/ 2>/dev/null || true && \
            rm -rf nomic-embed-v1.5-* cuda-libs.tar.gz && \
            echo "✓ CUDA libraries downloaded"; \
        else \
            echo "⚠ CUDA libraries not available (CPU-only mode)"; \
        fi; \
    else \
        echo "Skipping CUDA libraries (not supported on $TARGETARCH)"; \
    fi

# ============================================================================
# Stage 2: CPU Runtime
# ============================================================================
FROM debian:trixie-20260112-slim AS runtime-cpu

WORKDIR /app

# Copy binary from downloader stage
COPY --from=downloader /downloads/nomic-serve ./

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    dumb-init \
    && rm -rf /var/lib/apt/lists/*

# Default configuration
ENV PORT=8080
ENV TOKENIZER=models/txt/tokenizer.json

# Ensure models directory exists and is writable
RUN mkdir -p /app/models && chmod 777 /app/models

EXPOSE 8080

ENTRYPOINT ["dumb-init", "--"]
CMD ["./nomic-serve"]

# ============================================================================
# Stage 3: GPU Runtime (CUDA)
# ============================================================================
FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04 AS runtime-gpu

WORKDIR /app

# Copy binary from downloader stage
COPY --from=downloader /downloads/nomic-serve ./

# Copy ONNX Runtime CUDA provider libraries
COPY --from=downloader /downloads/lib ./lib

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    dumb-init \
    && rm -rf /var/lib/apt/lists/*

# Default configuration with GPU enabled
ENV PORT=8080
ENV TOKENIZER=models/txt/tokenizer.json
ENV USE_GPU=1
ENV LD_LIBRARY_PATH=/app/lib:/usr/local/cuda/lib64:/usr/local/cuda/targets/x86_64-linux/lib:${LD_LIBRARY_PATH}
ENV ORT_LOG_LEVEL=1
ENV ORT_LOG_SEVERITY_LEVEL=1

# Ensure models directory exists and is writable
RUN mkdir -p /app/models && chmod 777 /app/models

EXPOSE 8080

ENTRYPOINT ["dumb-init", "--"]
CMD ["./nomic-serve"]

